---
import { site } from "../site.config.js";
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const desc = description || site.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link rel="stylesheet" href={withBase("/styles/global.css")} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase("/rss.xml")} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase("/")}>{site.title}</a>
        <nav class="nav">
          {site.nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
        </nav>
        <form class="search-box" action={withBase("/search/")} method="get" role="search">
          <input type="search" name="q" placeholder="搜索…" aria-label="搜索" />
        </form>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.author}</span>
        {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </footer>
  </body>
</html>
