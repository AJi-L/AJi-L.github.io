---
import { site } from "../site.config.js";
import "../styles/global.css";
const { title, description, wide } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.description}`;
const desc = description || site.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/avatar.svg")} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase("/rss.xml")} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase("/")}>
          <img class="avatar" src={withBase("/avatar.svg")} alt="AJ" width="30" height="30" />
          <span>{site.title}</span>
        </a>
        <nav class="nav">
          {site.nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <form class="search-box" action={withBase("/search/")} method="get" role="search">
            <input type="search" name="q" placeholder="搜索…" aria-label="搜索" />
          </form>
          <button id="theme-toggle" class="icon-btn" type="button" title="切换主题" aria-label="切换主题">◐</button>
        </div>
      </div>
    </header>

    <main class={wide ? "wrap wrap-wide" : "wrap"}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.author}</span>
        <span class="links">
          <a href={withBase("/rss.xml")}>RSS</a>
          {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        function sync() {
          btn.textContent = document.documentElement.dataset.theme === "dark" ? "☀️" : "🌙";
          btn.title = document.documentElement.dataset.theme === "dark" ? "切换到浅色" : "切换到深色";
        }
        sync();
        btn.addEventListener("click", function () {
          var el = document.documentElement;
          var next = el.dataset.theme === "dark" ? "light" : "dark";
          el.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
