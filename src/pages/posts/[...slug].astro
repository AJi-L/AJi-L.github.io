---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { visiblePosts, tagSlug } from "../../lib/posts.js";

export function getStaticPaths() {
  return visiblePosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const Content = post.Content;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
const fmt = (d) => (d ? String(d).slice(0, 10) : "");
---
<BaseLayout title={post.title} description={post.summary}>
  <article class="post">
    <header>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <time>{fmt(post.date)}</time>
        {post.tags.map((t) => (
          <a class="tag" href={withBase(`/tags/${tagSlug(t)}/`)}>#{t}</a>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p style="margin-top:32px"><a href={withBase("/")}>← 返回首页</a></p>
</BaseLayout>
