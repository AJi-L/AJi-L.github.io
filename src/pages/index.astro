---
import BaseLayout from "../layouts/BaseLayout.astro";
import { visiblePosts } from "../lib/posts.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
const fmt = (d) => (d ? String(d).slice(0, 10) : "");
const posts = visiblePosts();
---
<BaseLayout>
  <h1>最新文章</h1>
  {posts.length === 0 ? (
    <p class="muted">还没有文章。</p>
  ) : (
    <ul class="post-list">
      {posts.map((p) => (
        <li class="post-item">
          <a class="post-link" href={withBase(p.url)}>
            <h2>{p.title}</h2>
            {p.summary && <p class="post-summary">{p.summary}</p>}
            <div class="post-meta">
              <time>{fmt(p.date)}</time>
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
