---
import BaseLayout from "../layouts/BaseLayout.astro";
import { visiblePosts } from "../lib/posts.js";
import { site } from "../site.config.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
const fmt = (d) => (d ? String(d).slice(0, 10) : "");
const posts = visiblePosts();
---
<BaseLayout>
  <section class="hero">
    <h1>{site.title}</h1>
    <p>{site.description}</p>
    <div class="links">
      <a href={withBase("/tags/")}>标签</a>
      <a href={withBase("/search/")}>搜索</a>
      <a href={withBase("/rss.xml")}>RSS</a>
      {site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
    </div>
  </section>

  <h2 class="section-title">最近文章</h2>
  {posts.length === 0 ? (
    <p class="empty">还没有文章。</p>
  ) : (
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a class="post-card" href={withBase(p.url)}>
            <h2>{p.title}</h2>
            {p.summary && <p class="summary">{p.summary}</p>}
            <div class="post-meta">
              <time>{fmt(p.date)}</time>
              <span class="dot">·</span>
              <span>{p.minutes} 分钟</span>
              {p.tags.length > 0 && <span class="dot">·</span>}
              {p.tags.map((t) => (
                <span class="tag">#{t}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
