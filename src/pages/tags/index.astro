---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { visiblePosts, collectTags, tagSlug } from "../../lib/posts.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
const tags = collectTags(visiblePosts());
---
<BaseLayout title="标签">
  <h1>标签</h1>
  {tags.length === 0 ? (
    <p class="muted">暂无标签。</p>
  ) : (
    <div class="tag-cloud">
      {tags.map((t) => (
        <a href={withBase(`/tags/${tagSlug(t.name)}/`)}>
          {t.name} <span class="count">{t.count}</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
