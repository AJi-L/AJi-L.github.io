---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (p) => `${base}${p}`;
---
<BaseLayout title="关于">
  <article class="post">
    <header><h1>关于</h1></header>
    <div class="prose">
      <p>我是 {site.author}。这里放我整理过的技术笔记、开发记录与知识。</p>
      <ul>
        {site.social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
      <p class="muted">站点用 Astro 生成，部署在 GitHub Pages。</p>
    </div>
  </article>
</BaseLayout>
